{
  "name": "@tochemey/nodeakt",
  "version": "0.1.0",
  "description": "Actor framework for Node, Bun, and Deno: typed actors, supervision, mailboxes, behaviors, an event stream, and a multi-core runtime",
  "keywords": [
    "actor",
    "actors",
    "actor-model",
    "actor-system",
    "concurrency",
    "message-passing",
    "supervision",
    "mailbox",
    "event-stream",
    "multicore",
    "worker-threads",
    "typescript",
    "bun",
    "deno"
  ],
  "homepage": "https://tochemey.github.io/nodeakt/",
  "bugs": {
    "url": "https://github.com/Tochemey/nodeakt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tochemey/nodeakt.git"
  },
  "license": "MIT",
  "author": "GoAkt Team",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage",
    "bench": "vitest run --config vitest.bench.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "example": "tsx",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "lefthook": "^2.1.10",
    "mermaid": "^11.17.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-renderer": "^1.2.0",
    "vitest": "^4.1.11"
  }
}
